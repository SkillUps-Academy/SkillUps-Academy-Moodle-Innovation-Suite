<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/skillupsexam/db" VERSION="20261124" COMMENT="SkillUps Exam Manager"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
  <TABLES>
    <TABLE NAME="local_skillupsexam_period" COMMENT="Exam Manager period records">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="categoryid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="name" TYPE="char" LENGTH="120" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="starts" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="ends" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="category_name" UNIQUE="true" FIELDS="categoryid,name"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_skillupsexam_room" COMMENT="Exam Manager room records">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="categoryid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="campus" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="name" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="capacity" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="site_room" UNIQUE="true" FIELDS="categoryid,campus,name"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_skillupsexam_exam" COMMENT="Exam Manager exam records">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="periodid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="roomid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="groupid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="cmid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="teacherid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="supervisor" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="name" TYPE="char" LENGTH="160" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="mode" TYPE="char" LENGTH="12" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="status" TYPE="char" LENGTH="12" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="regmode" TYPE="char" LENGTH="12" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="starts" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="ends" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="instruction" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="revision" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="updated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="requestkey" TYPE="char" LENGTH="32" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="periodid_fk" TYPE="foreign" FIELDS="periodid" REFTABLE="local_skillupsexam_period" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="unique_request" UNIQUE="true" FIELDS="requestkey"/>
        <INDEX NAME="course_date" UNIQUE="false" FIELDS="courseid,starts"/>
        <INDEX NAME="room_date" UNIQUE="false" FIELDS="roomid,starts"/>
        <INDEX NAME="teacher_date" UNIQUE="false" FIELDS="teacherid,starts"/>
        <INDEX NAME="staff_date" UNIQUE="false" FIELDS="supervisor,starts"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_skillupsexam_seat" COMMENT="Exam Manager seat records">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="examid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="examid_fk" TYPE="foreign" FIELDS="examid" REFTABLE="local_skillupsexam_exam" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="student_exam" UNIQUE="true" FIELDS="examid,userid"/>
        <INDEX NAME="user_ix" UNIQUE="false" FIELDS="userid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_skillupsexam_mark" COMMENT="Exam Manager mark records">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="examid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="actorid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="status" TYPE="char" LENGTH="12" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="note" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="marked" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="examid_fk" TYPE="foreign" FIELDS="examid" REFTABLE="local_skillupsexam_exam" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="student_exam" UNIQUE="true" FIELDS="examid,userid"/>
        <INDEX NAME="user_ix" UNIQUE="false" FIELDS="userid"/>
        <INDEX NAME="actor_ix" UNIQUE="false" FIELDS="actorid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_skillupsexam_case" COMMENT="Exam Manager case records">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="examid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="authorid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="relatedid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="severity" TYPE="char" LENGTH="12" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="details" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="created" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="examid_fk" TYPE="foreign" FIELDS="examid" REFTABLE="local_skillupsexam_exam" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="exam_time" UNIQUE="false" FIELDS="examid,created"/>
        <INDEX NAME="author_ix" UNIQUE="false" FIELDS="authorid"/>
        <INDEX NAME="user_ix" UNIQUE="false" FIELDS="relatedid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_skillupsexam_audit" COMMENT="Exam Manager audit records">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="examid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="actorid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="subjectid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="action" TYPE="char" LENGTH="18" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="reason" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="beforedata" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="afterdata" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="created" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="examid_fk" TYPE="foreign" FIELDS="examid" REFTABLE="local_skillupsexam_exam" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="exam_time" UNIQUE="false" FIELDS="examid,created"/>
        <INDEX NAME="actor_ix" UNIQUE="false" FIELDS="actorid"/>
        <INDEX NAME="user_ix" UNIQUE="false" FIELDS="subjectid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_skillupsexam_queue" COMMENT="Exam Manager queue records">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="examid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="revision" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="kind" TYPE="char" LENGTH="12" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="status" TYPE="char" LENGTH="12" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="cursorid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="attempts" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="nexttry" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="examid_fk" TYPE="foreign" FIELDS="examid" REFTABLE="local_skillupsexam_exam" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="exam_notice" UNIQUE="true" FIELDS="examid,revision,kind"/>
        <INDEX NAME="ready_jobs" UNIQUE="false" FIELDS="status,nexttry"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
