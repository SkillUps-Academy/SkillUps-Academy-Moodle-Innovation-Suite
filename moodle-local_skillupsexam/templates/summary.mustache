{{!
    @template local_skillupsexam/summary
    Show counts for the currently filtered convocations.
    Example context (json):
    {
        "states": [{"count": 3, "label": "Scheduled"}]
    }
}}
<ul class="exam-summary">
    {{#states}}
        <li><strong>{{count}}</strong> {{label}}</li>
    {{/states}}
</ul>
