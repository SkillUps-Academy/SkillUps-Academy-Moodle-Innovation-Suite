{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "id": null,
  "uid": "skillups-moodle-monitor",
  "title": "SkillUps System Monitor",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "moodle",
    "skillups"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "title": "Internal Moodle observation",
      "description": "State 1 means healthy or fresh. Gaps have no interpolation.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "skillups_moodle_sample_fresh{job=\"skillups-moodle\"}",
          "legendFormat": "Freshness",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "skillups_moodle_cron_healthy{job=\"skillups-moodle\"}",
          "legendFormat": "Cron",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "skillups_moodle_readiness{job=\"skillups-moodle\"}",
          "legendFormat": "Internal readiness",
          "refId": "C"
        }
      ]
    },
    {
      "id": 2,
      "title": "Age of observations",
      "description": "Age of the sample and the native cron heartbeat.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "skillups_moodle_sample_age_seconds{job=\"skillups-moodle\"}",
          "legendFormat": "Sample age",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "skillups_moodle_cron_age_seconds{job=\"skillups-moodle\"}",
          "legendFormat": "Cron age",
          "refId": "B"
        }
      ]
    },
    {
      "id": 3,
      "title": "Latency of internal database check",
      "description": "Duration of the last indexed site-row observation.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "skillups_moodle_probe_duration_seconds{job=\"skillups-moodle\"}",
          "legendFormat": "Internal latency",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Overdue and failing tasks",
      "description": "Core task queues and recent recorded failures.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "skillups_moodle_scheduled_overdue{job=\"skillups-moodle\"}",
          "legendFormat": "Scheduled overdue",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "skillups_moodle_adhoc_overdue{job=\"skillups-moodle\"}",
          "legendFormat": "Ad hoc overdue",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "skillups_moodle_task_failures_recent{job=\"skillups-moodle\"}",
          "legendFormat": "Failures over 15m",
          "refId": "C"
        }
      ]
    },
    {
      "id": 5,
      "title": "External HTTP probe",
      "description": "Requires the independently configured Blackbox Exporter.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "probe_success{job=\"skillups-moodle-blackbox\"}",
          "legendFormat": "Probe success",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "up{job=\"skillups-moodle-blackbox\"}",
          "legendFormat": "Exporter scrape",
          "refId": "B"
        }
      ]
    },
    {
      "id": 6,
      "title": "External round trip",
      "description": "Total duration for the external HTTPS probe.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "probe_duration_seconds{job=\"skillups-moodle-blackbox\"}",
          "legendFormat": "External probe duration",
          "refId": "A"
        }
      ]
    }
  ]
}
