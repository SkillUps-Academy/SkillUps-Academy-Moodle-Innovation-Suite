{{! @template local_skillupsquestionstudio/assessment }}
<div class="qs-studio">
    <header class="qs-header">
        <div><h2>{{name}}</h2><p>{{#str}} assessmentintro, local_skillupsquestionstudio {{/str}}</p></div>
        <div class="qs-actions"><a class="btn btn-outline-secondary" href="{{back}}">{{#str}} project, local_skillupsquestionstudio {{/str}}</a>
            {{#export}}<a class="btn btn-outline-primary" href="{{export}}">{{#str}} export, local_skillupsquestionstudio {{/str}}</a>{{/export}}</div>
    </header>
    {{#stale}}<p class="alert alert-warning" role="status">{{#str}} stalevariant, local_skillupsquestionstudio {{/str}}</p>{{/stale}}
    {{^stale}}<section class="qs-panel">
        <div class="qs-actions mb-3"><a class="btn btn-outline-secondary" href="{{keyurl}}">
            {{#key}}{{#str}} hidekey, local_skillupsquestionstudio {{/str}}{{/key}}{{^key}}{{#str}} showkey, local_skillupsquestionstudio {{/str}}{{/key}}</a></div>
        <ol class="qs-assessment">{{#records}}<li>{{> local_skillupsquestionstudio/question }}</li>{{/records}}</ol>
    </section>{{/stale}}
    {{#publish}}<section class="qs-panel">
        <h3>{{#str}} publish, local_skillupsquestionstudio {{/str}}</h3>
        {{#canimport}}<form method="post" action="{{url}}" class="qs-actions align-items-end">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <div><label for="qs-bank">{{#str}} category, local_skillupsquestionstudio {{/str}}</label><select id="qs-bank" class="form-select" name="categoryid" required>
                {{#categories}}<option value="{{id}}">{{label}}</option>{{/categories}}
            </select></div>
            <button type="submit" class="btn btn-primary">{{#str}} importbank, local_skillupsquestionstudio {{/str}}</button>
        </form>{{/canimport}}
        {{^canimport}}<p>{{#str}} nocategories, local_skillupsquestionstudio {{/str}}</p>{{/canimport}}
    </section>{{/publish}}
</div>
