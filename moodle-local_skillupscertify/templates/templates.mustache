{{!
    @template local_skillupscertify/templates

    Render templates information.

    Example context (json):
    {}
}}
<section class="skillups-certify">
    <h2 class="h3">{{#str}}templates, local_skillupscertify{{/str}}</h2>
    {{> local_skillupscertify/nav}}
    {{#error}}<p class="alert alert-danger" role="alert">{{error}}</p>{{/error}}
    {{#editing}}
        <p><a href="{{returnurl}}">{{#str}}backtemplates, local_skillupscertify{{/str}}</a> {{revision}}</p>
        <span id="skillups-certify-sample" hidden data-recipient="{{sample}}" data-course="{{examplecourse}}"
            data-preview="{{#str}}visualpreview, local_skillupscertify{{/str}}" data-example="{{#str}}sampleonly, local_skillupscertify{{/str}}"></span>
    {{/editing}}
    {{^editing}}
        <p><a class="btn btn-primary" href="{{createurl}}">{{#str}}newtemplate, local_skillupscertify{{/str}}</a></p>
        <div class="table-responsive">
    <table class="table align-middle">
        <thead><tr><th scope="col">{{#str}}label, local_skillupscertify{{/str}}</th><th scope="col">{{#str}}revision, local_skillupscertify{{/str}}</th><th scope="col">{{#str}}status, local_skillupscertify{{/str}}</th></tr></thead>
        <tbody>
            {{#rows}}<tr><td><a href="{{url}}">{{label}}</a></td><td>{{edition}}</td><td>{{state}}</td></tr>{{/rows}}
            {{^rows}}<tr><td colspan="3">{{#str}}notemplates, local_skillupscertify{{/str}}</td></tr>{{/rows}}
        </tbody>
    </table>
</div>
    {{/editing}}
</section>
