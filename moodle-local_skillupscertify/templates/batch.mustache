{{!
    @template local_skillupscertify/batch

    Render batch information.

    Example context (json):
    {}
}}
<section class="skillups-certify">
    <h2 class="h3">{{#str}}batchheading, local_skillupscertify{{/str}}</h2>
    {{> local_skillupscertify/nav}}
    <h3 class="h5">{{identifier}}</h3>
    <p>{{state}} · {{created}}</p>
    {{#pending}}<p><a class="btn btn-outline-primary" href="{{url}}">{{#str}}refresh, local_skillupscertify{{/str}}</a></p>{{/pending}}
    <dl class="row row-cols-2 row-cols-md-4">{{#metrics}}<div class="col"><dt>{{label}}</dt><dd class="h4">{{count}}</dd></div>{{/metrics}}</dl>
    <div class="table-responsive">
    <table class="table align-middle">
        <thead><tr><th scope="col">{{#str}}recipient, local_skillupscertify{{/str}}</th><th scope="col">{{#str}}status, local_skillupscertify{{/str}}</th></tr></thead>
        <tbody>
            {{#rows}}<tr><td>{{recipient}}</td><td>{{#url}}<a href="{{url}}">{{status}}</a>{{/url}}{{^url}}{{status}}{{/url}}</td></tr>{{/rows}}
            {{^rows}}<tr><td colspan="2">{{#str}}norecords, local_skillupscertify{{/str}}</td></tr>{{/rows}}
        </tbody>
    </table>
</div>
</section>
