{{!
    @template local_skillupsscheduler/planner
    Accessible academic scheduling calendar and filters.
    Example context (json):
    {"range":"week","day":"2026-11-24","title":"Academic week","timezone":"UTC","days":[]}
}}
<section class="local-scheduler" aria-labelledby="scheduler-title">
    <header class="scheduler-header d-flex flex-wrap justify-content-between align-items-end gap-3">
        <div>
            <p class="scheduler-brand">SkillUps Academy</p>
            <h1 id="scheduler-title">SkillUps Scheduler</h1>
            <p>{{#str}} plannerdetail, local_skillupsscheduler {{/str}}</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            {{#catalog}}<a class="btn btn-outline-light" href="{{catalog}}">{{#str}} catalog, local_skillupsscheduler {{/str}}</a>{{/catalog}}
            {{#add}}<a class="btn btn-light" href="{{add}}">{{#str}} newsession, local_skillupsscheduler {{/str}}</a>{{/add}}
        </div>
    </header>
    <form class="scheduler-filters" method="get" action="{{pickday}}">
        <input type="hidden" name="range" value="{{range}}">
        <div class="scheduler-filtergrid">
            <div>
                <label for="scheduler-day">{{#str}} day, local_skillupsscheduler {{/str}}</label>
                <input class="form-control" type="date" name="day" id="scheduler-day" value="{{day}}" required>
            </div>
            {{#selects}}
                <div>
                    <label for="scheduler-{{name}}">{{label}}</label>
                    <select class="form-select" id="scheduler-{{name}}" name="{{name}}">
                        {{#options}}<option value="{{id}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/options}}
                    </select>
                </div>
            {{/selects}}
        </div>
        <div class="d-flex gap-3 align-items-center flex-wrap mt-3">
            <button class="btn btn-primary" type="submit">{{#str}} applyfilters, local_skillupsscheduler {{/str}}</button>
            {{#canplan}}
                <label class="mb-0"><input type="checkbox" name="issues" value="1" {{#issues}}checked{{/issues}}>
                    {{#str}} conflictsonly, local_skillupsscheduler {{/str}}</label>
            {{/canplan}}
            {{#ledger}}<a href="{{ledger}}">{{#str}} deliveryqueue, local_skillupsscheduler {{/str}}</a>{{/ledger}}
        </div>
    </form>
    <div class="d-flex flex-wrap justify-content-between gap-2 my-3">
        <nav class="btn-group" aria-label="{{#str}} calendarviews, local_skillupsscheduler {{/str}}">
            {{#ranges}}<a class="btn btn-outline-secondary {{#selected}}active{{/selected}}" href="{{url}}"
                {{#selected}}aria-current="page"{{/selected}}>{{label}}</a>{{/ranges}}
        </nav>
        <nav class="d-flex gap-2 flex-wrap" aria-label="{{#str}} calendarnavigation, local_skillupsscheduler {{/str}}">
            <a class="btn btn-outline-secondary" href="{{previous}}">{{#str}} previous, local_skillupsscheduler {{/str}}</a>
            <a class="btn btn-outline-secondary" href="{{today}}">{{#str}} today, local_skillupsscheduler {{/str}}</a>
            <a class="btn btn-outline-secondary" href="{{next}}">{{#str}} next, local_skillupsscheduler {{/str}}</a>
            {{^issues}}<a class="btn btn-outline-secondary" href="{{download}}">{{#str}} ics, local_skillupsscheduler {{/str}}</a>{{/issues}}
        </nav>
    </div>
    {{#hasunstaffed}}
        <section class="alert alert-warning" aria-labelledby="scheduler-course-conflicts">
            <h2 id="scheduler-course-conflicts" class="h5">{{#str}} unstaffedcourses, local_skillupsscheduler {{/str}}</h2>
            <ul class="mb-0">
                {{#unstaffed}}<li><a href="{{url}}">{{course}}</a> · {{campus}}</li>{{/unstaffed}}
            </ul>
        </section>
    {{/hasunstaffed}}
    <h2 class="h4">{{title}}</h2>
    <p>{{selectedrange}} · {{timezone}}</p>
    {{#empty}}<p class="alert alert-info">{{#str}} noresults, local_skillupsscheduler {{/str}}</p>{{/empty}}
    <div class="scheduler-grid{{#month}} scheduler-month{{/month}}{{#week}} scheduler-week{{/week}}">
        {{#month}}{{#weekdays}}<div class="scheduler-weekday">{{label}}</div>{{/weekdays}}{{/month}}
        {{#days}}
            {{#blank}}<div class="scheduler-pad" aria-hidden="true"></div>{{/blank}}
            {{^blank}}
                <section class="scheduler-day{{#today}} scheduler-today{{/today}}">
                    <h3 class="h6"><a href="{{url}}" {{#today}}aria-current="date"{{/today}}>{{label}}</a></h3>
                    {{#slots}}
                        <article class="scheduler-card{{#pending}} scheduler-pending{{/pending}}">
                            <span class="scheduler-hours">{{hours}}</span>
                            <a href="{{url}}">{{title}}</a>
                            <span class="scheduler-caption">{{campus}} · {{course}} · {{status}}</span>
                            {{#issue}}<p class="scheduler-issue">{{issue}}</p>{{/issue}}
                        </article>
                    {{/slots}}
                </section>
            {{/blank}}
        {{/days}}
    </div>
</section>
