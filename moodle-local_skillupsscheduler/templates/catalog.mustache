{{!
    @template local_skillupsscheduler/catalog
    Campus configuration and notification delivery monitor.
    Example context (json):
    {"sites":[{"name":"North","url":"/local/skillupsscheduler/catalog.php?siteid=1"}],"sections":[]}
}}
<section class="local-scheduler">
    <a href="{{back}}">{{#str}} backplanner, local_skillupsscheduler {{/str}}</a>
    <header class="d-flex justify-content-between align-items-center flex-wrap gap-2 py-3">
        <h1>{{#str}} catalog, local_skillupsscheduler {{/str}}</h1>
        <a href="{{newsite}}" class="btn btn-primary">{{#str}} newcampus, local_skillupsscheduler {{/str}}</a>
    </header>
    <nav class="d-flex flex-wrap gap-2 mb-4" aria-label="{{#str}} choosecampus, local_skillupsscheduler {{/str}}">
        {{#sites}}<a class="btn btn-outline-primary" href="{{url}}">{{name}}</a>{{/sites}}
    </nav>
    {{#campus}}<h2>{{campus}}</h2><a href="{{editsite}}">{{#str}} editcampus, local_skillupsscheduler {{/str}}</a>{{/campus}}
    <div class="scheduler-detail my-3">
        {{#sections}}
            <section>
                <h3 class="h5">{{name}}</h3>
                <a href="{{add}}">{{#str}} add, local_skillupsscheduler {{/str}}</a>
                <ul class="list-group list-group-flush">
                    {{#rows}}
                        <li class="list-group-item">
                            {{#edit}}<a href="{{edit}}">{{name}}</a>{{/edit}}
                            {{^edit}}<strong>{{name}}</strong>{{/edit}}
                            <div>{{details}}</div>
                            {{#revoke}}
                                <form method="post" action="{{url}}">
                                    <input type="hidden" name="siteid" value="{{siteid}}">
                                    <input type="hidden" name="revoke" value="{{revoke}}">
                                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        {{#str}} revoke, local_skillupsscheduler {{/str}}
                                    </button>
                                </form>
                            {{/revoke}}
                        </li>
                    {{/rows}}
                </ul>
            </section>
        {{/sections}}
    </div>
    {{#showqueue}}
        <h2>{{#str}} deliveryqueue, local_skillupsscheduler {{/str}}</h2>
        <ul class="list-group">
            {{#jobs}}<li class="list-group-item"><a href="{{link}}">#{{id}}</a> · {{date}} ·
                {{#str}} attempts, local_skillupsscheduler {{/str}} {{attempts}}
                {{#exhausted}} · {{#str}} exhausted, local_skillupsscheduler {{/str}}{{/exhausted}}</li>{{/jobs}}
            {{^jobs}}<li class="list-group-item">{{#str}} noresults, local_skillupsscheduler {{/str}}</li>{{/jobs}}
        </ul>
    {{/showqueue}}
</section>
