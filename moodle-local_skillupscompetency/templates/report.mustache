{{!
    @template local_skillupscompetency/report
    Authorized competency gap report and CSV export.
    Example context (json):
    {"title":"Design · Spring","heads":[],"rows":[]}
}}
<section class="local-skillupscm">
    <a href="{{back}}">{{#str}} back, local_skillupscompetency {{/str}}</a>
    <h1 class="mt-3">{{#str}} gapreport, local_skillupscompetency {{/str}}</h1>
    <p>{{title}}</p>
    <div class="skillupscm-panel">
        <form class="d-flex flex-wrap gap-2 align-items-center" method="get" action="{{form}}">
            <input type="hidden" name="programid" value="{{pid}}">
            <input type="hidden" name="termid" value="{{tid}}">
            <input type="hidden" name="op" value="report">
            <label for="skillupscm-course">{{#str}} course, local_skillupscompetency {{/str}}</label>
            <select class="form-select w-auto" id="skillupscm-course" name="courseid">
                {{#filters}}<option value="{{id}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/filters}}
            </select>
            <label for="skillupscm-group">{{#str}} group, local_skillupscompetency {{/str}}</label>
            <select class="form-select w-auto" id="skillupscm-group" name="groupid">
                <option value="0">{{#str}} allgroups, local_skillupscompetency {{/str}}</option>
                {{#groups}}<option value="{{id}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/groups}}
            </select>
            <button class="btn btn-primary" type="submit">{{#str}} applyfilters, local_skillupscompetency {{/str}}</button>
            {{#export}}<a class="btn btn-outline-primary" href="{{export}}">{{#str}} exportresults, local_skillupscompetency {{/str}}</a>{{/export}}
        </form>
    </div>
    <dl class="skillupscm-grid mt-3">
        {{#stats}}<div class="skillupscm-panel"><dt>{{label}}</dt><dd class="h3 mb-0">{{count}}</dd></div>{{/stats}}
    </dl>
    <div class="table-responsive mt-3">
        <table class="table table-striped">
            <thead><tr>{{#heads}}<th scope="col">{{name}}</th>{{/heads}}</tr></thead>
            <tbody>
                {{#rows}}
                    <tr><td>{{course}}</td><th scope="row">{{student}}</th><td>{{competency}}</td>
                        <td>{{code}}</td><td>{{expected}}</td><td>{{current}}</td><td>{{gap}}</td><td>{{state}}</td></tr>
                {{/rows}}
                {{^rows}}<tr><td colspan="8">{{#str}} empty, local_skillupscompetency {{/str}}</td></tr>{{/rows}}
            </tbody>
        </table>
    </div>
</section>
