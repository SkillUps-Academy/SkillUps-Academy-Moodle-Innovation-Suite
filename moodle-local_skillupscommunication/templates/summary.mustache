{{!
    @template local_skillupscommunication/summary
    Present campaign counts by state.
    Example context (json):
    {"items":[{"label":"Queued","count":3}]}
}}
<ul class="sc-summary">
    {{#items}}
        <li><strong>{{count}}</strong> <span>{{label}}</span></li>
    {{/items}}
</ul>
