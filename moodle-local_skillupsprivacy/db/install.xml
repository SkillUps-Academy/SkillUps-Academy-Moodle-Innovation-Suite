<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/skillupsprivacy/db" VERSION="20261123" COMMENT="SkillUps Privacy Manager"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
  <TABLES>
    <TABLE NAME="local_skillupsprivacy_case" COMMENT="Internal request and retention review">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="createdby" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="ownerid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="nativeid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="nativestatus" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="-1"/>
        <FIELD NAME="kind" TYPE="char" LENGTH="15" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="state" TYPE="char" LENGTH="15" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="retention" TYPE="char" LENGTH="12" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="contextid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="due" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="checkedat" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="revision" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="1"/>
        <FIELD NAME="archived" TYPE="int" LENGTH="1" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="nativeref_ix" UNIQUE="true" FIELDS="nativeid"/>
        <INDEX NAME="subject_ix" UNIQUE="false" FIELDS="userid,id"/>
        <INDEX NAME="creator_ix" UNIQUE="false" FIELDS="createdby,id"/>
        <INDEX NAME="owner_ix" UNIQUE="false" FIELDS="ownerid,state,due"/>
        <INDEX NAME="queue_ix" UNIQUE="false" FIELDS="state,due,id"/>
        <INDEX NAME="sync_ix" UNIQUE="false" FIELDS="checkedat,id"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_skillupsprivacy_audit" COMMENT="Case history and privileged access">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="caseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="actorid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="priorid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="targetid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="operation" TYPE="char" LENGTH="24" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="previous" TYPE="char" LENGTH="24" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="result" TYPE="char" LENGTH="24" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="note" TYPE="char" LENGTH="300" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="casehistory_ix" UNIQUE="false" FIELDS="caseid,id"/>
        <INDEX NAME="actor_ix" UNIQUE="false" FIELDS="actorid,id"/>
        <INDEX NAME="prior_ix" UNIQUE="false" FIELDS="priorid,id"/>
        <INDEX NAME="target_ix" UNIQUE="false" FIELDS="targetid,id"/>
        <INDEX NAME="recent_ix" UNIQUE="false" FIELDS="timecreated,id"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_skillupsprivacy_notice" COMMENT="Deduplicated deadline delivery claims">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="caseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="due" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="level" TYPE="int" LENGTH="1" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="status" TYPE="char" LENGTH="12" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="once_ix" UNIQUE="true" FIELDS="caseid,userid,due,level"/>
        <INDEX NAME="recipient_ix" UNIQUE="false" FIELDS="userid,id"/>
        <INDEX NAME="recent_ix" UNIQUE="false" FIELDS="timecreated,id"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
