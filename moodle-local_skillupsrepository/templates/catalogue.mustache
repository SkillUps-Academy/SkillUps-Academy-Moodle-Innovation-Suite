{{!
    @template local_skillupsrepository/catalogue
    Render an authorized page of catalogue entries.
    Example context (json):
    {"list":false,"items":[{"url":"/","kind":"Image","category":"Arts","title":"Study guide","description":"An introduction","license":"CC BY"}]}
}}
<ul class="sr-cards {{#list}}sr-list{{/list}}">
    {{#items}}
        <li class="sr-card">
            <div class="sr-kind">{{kind}} · {{category}}</div>
            <div class="sr-card-body">
                {{#status}}<p class="sr-muted">{{status}}</p>{{/status}}
                <h3><a href="{{url}}">{{title}}</a></h3>
                {{#description}}<p>{{description}}</p>{{/description}}
                {{#credit}}<p class="sr-muted">{{credit}}</p>{{/credit}}
                {{#collection}}<p class="sr-muted">{{collection}}</p>{{/collection}}
                {{#tags}}<p class="sr-muted">{{tags}}</p>{{/tags}}
                <p class="sr-license">{{license}}</p>
            </div>
        </li>
    {{/items}}
</ul>
