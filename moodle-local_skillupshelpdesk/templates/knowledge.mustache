{{!
    @template local_skillupshelpdesk/knowledge

    SkillUps Helpdesk knowledge.

    Example context (json):
    {"portalurl":"#","knowledgeurl":"#","listing":true}
}}
<div class="skillups-helpdesk">
    {{> local_skillupshelpdesk/nav}}
    {{#listing}}
        <h2 class="h3">{{#str}}knowledge, local_skillupshelpdesk{{/str}}</h2>
        <form method="get" action="{{knowledgeurl}}" class="d-flex flex-wrap gap-2 align-items-end mb-4">
            <div>
                <label class="form-label" for="helpdesk-knowledge-search">{{#str}}searchknowledge, local_skillupshelpdesk{{/str}}</label>
                <input class="form-control" id="helpdesk-knowledge-search" type="search" name="q" maxlength="80" value="{{q}}">
            </div>
            <button class="btn btn-outline-primary">{{#str}}search, local_skillupshelpdesk{{/str}}</button>
        </form>
        <div class="row g-3 mb-3">
            {{#articles}}
                <div class="col-md-6">
                    <article class="h-100 border rounded p-3">
                        <h3 class="h5"><a href="{{url}}">{{title}}</a></h3>
                        <p class="mb-0 text-break">{{summary}}</p>
                    </article>
                </div>
            {{/articles}}
            {{^articles}}<p class="text-muted">{{#str}}noarticles, local_skillupshelpdesk{{/str}}</p>{{/articles}}
        </div>
        {{{pager}}}
    {{/listing}}
    {{#article}}
        <article class="border rounded p-4">
            <h2 class="h3">{{title}}</h2>
            <div class="helpdesk-plaintext text-break">{{body}}</div>
        </article>
    {{/article}}
</div>
