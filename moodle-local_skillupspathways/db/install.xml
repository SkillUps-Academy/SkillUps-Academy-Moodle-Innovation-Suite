<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/skillupspathways/db" VERSION="20261123" COMMENT="SkillUps Learning Path Designer"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
  <TABLES>
    <TABLE NAME="local_skillupspathways_path" COMMENT="Anchor-scoped itinerary and optimistic draft">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="name" TYPE="char" LENGTH="180" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="description" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="draft" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="revision" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="1"/>
        <FIELD NAME="activeversion" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="enabled" TYPE="int" LENGTH="1" NOTNULL="true" SEQUENCE="false" DEFAULT="1"/>
        <FIELD NAME="certificate" TYPE="int" LENGTH="1" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="course_fk" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="coursepath_ix" UNIQUE="false" FIELDS="courseid,enabled"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_skillupspathways_version" COMMENT="Immutable published graph snapshots">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="pathid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="versionnum" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="name" TYPE="char" LENGTH="180" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="description" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="graph" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="path_fk" TYPE="foreign" FIELDS="pathid" REFTABLE="local_skillupspathways_path" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="versionnum_ix" UNIQUE="true" FIELDS="pathid,versionnum"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_skillupspathways_progress" COMMENT="Pinned itinerary and participant outcomes">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="pathid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="versionid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="states" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="passed" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="requiredcount" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="completedat" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="timechecked" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="path_fk" TYPE="foreign" FIELDS="pathid" REFTABLE="local_skillupspathways_path" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="individual_ix" UNIQUE="true" FIELDS="pathid,userid"/>
        <INDEX NAME="userid_ix" UNIQUE="false" FIELDS="userid,pathid"/>
        <INDEX NAME="checks_ix" UNIQUE="false" FIELDS="timechecked,id"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_skillupspathways_history" COMMENT="Milestone state transitions and explicit migration">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="pathid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="versionid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="nodekey" TYPE="char" LENGTH="40" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="oldstate" TYPE="char" LENGTH="16" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="newstate" TYPE="char" LENGTH="16" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="path_fk" TYPE="foreign" FIELDS="pathid" REFTABLE="local_skillupspathways_path" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="timeline_ix" UNIQUE="false" FIELDS="pathid,userid,id"/>
        <INDEX NAME="userpath_ix" UNIQUE="false" FIELDS="userid,pathid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_skillupspathways_audit" COMMENT="Path management event records">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="pathid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="operation" TYPE="char" LENGTH="16" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="path_fk" TYPE="foreign" FIELDS="pathid" REFTABLE="local_skillupspathways_path" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="auditpath_ix" UNIQUE="false" FIELDS="pathid,id"/>
        <INDEX NAME="userpath_ix" UNIQUE="false" FIELDS="userid,pathid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
